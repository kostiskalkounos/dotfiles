#!/usr/bin/env zsh

source "${0:a:h}/common"

typeset -i all_mode="${KT_ALL:-0}"
if [[ "${1:-}" == "--all" ]]; then
  all_mode=1
  shift
fi

build_lines() {
  local tabs_data="${1:-}"
  [[ -z "${tabs_data}" ]] && return 0

  local -a lines=( ${(f)tabs_data} )
  local prev_tab_id="${${lines[1]:-}#PREV_TAB_ID:}"
  local -a tab_lines=( ${lines[@][2,-1]} )

  local tab_id is_current title disp cur_line="" line
  local -a rest=() parts=()
  local -i idx=0
  for line in "${tab_lines[@]}"; do
    parts=( "${(@ps:$tab:)line}" )
    tab_id="${parts[1]:-}"
    is_current="${parts[2]:-}"
    title="${parts[3]:-}"
    local proc_cwd="${parts[4]:-}"
    local win_cwd="${parts[5]:-}"
    local final_cwd="${proc_cwd:-$win_cwd}"

    if [[ -n "${win_cwd}" && -n "${proc_cwd}" ]]; then
      local win_p="${win_cwd:A}" proc_p="${proc_cwd:A}"
      if [[ "${proc_p}/" == "${win_p%/}/"* ]]; then
        final_cwd="${win_cwd%/}${proc_p#${win_p%/}}"
      fi
    fi

    idx+=1
    disp="${idx}: ${title}${tab}${(D)final_cwd}"
    if [[ "${is_current}" == "1" ]]; then
      cur_line="${active_color}${disp}${reset_color}${tab}${tab_id}"
    else
      rest+=("${disp}${tab}${tab_id}")
    fi
  done

  reorder_lines_with_previous "${prev_tab_id}" "${rest[@]}"
  rest=( "${REPLY_LINES[@]}" )

  print_fzf_lines "${cur_line}" "${rest[@]}"
}

if [[ "${1:-}" == "--close-and-list" ]]; then
  typeset target="${2:-}"
  typeset cur="${3:-}"
  typeset json=""
  if [[ -n "${target}" && "${target}" != "${cur}" ]]; then
    json="$("${KITTY_BIN}" @ ls 2>/dev/null || true)"
    if ! has_active_processes "tab" "${target}" "${json}"; then
      "${KITTY_BIN}" @ close-tab --match "id:${target}" 2>/dev/null || true
      json="$("${KITTY_BIN}" @ ls 2>/dev/null || true)"
      trigger_cleanup "${json}"
    fi
  fi
  typeset tabs_data="$(get_tabs_data "${json}" "${launch_window_id:-0}" "${all_mode:-0}")"
  build_lines "${tabs_data}"
  exit 0
fi

typeset main_json="$("${KITTY_BIN}" @ ls 2>/dev/null || true)"
trigger_cleanup "${main_json}"

typeset main_tabs_data="$(get_tabs_data "${main_json}" "${launch_window_id:-0}" "${all_mode:-0}")"
typeset lines="$(build_lines "${main_tabs_data}")"
if [[ -z "${lines}" ]]; then
  echo "No tabs found."
  exit 0
fi

export KT_ALL="${all_mode}"

typeset prompt_label="Switch Tab > "
[[ "${all_mode}" == "1" ]] && prompt_label="Switch Tab (all) > "

run_kitty_fzf_with_close "${0:a}" "${lines}" "${prompt_label}" "ctrl-x" --no-sort

if [[ $FZF_RC -ne 0 || -z "${FZF_SELECTED}" ]]; then
  exit 0
fi

typeset selected_tab="${FZF_SELECTED##*${tab}}"
"${KITTY_BIN}" @ focus-tab --match "id:${selected_tab}" 2>/dev/null || true
