#!/usr/bin/env zsh

set -euo pipefail

SCRIPT_DIR="${0:a:h}"

typeset -U path
path=(/opt/homebrew/bin /usr/local/bin /usr/bin /bin /usr/sbin /sbin $path)

[[ -z "${KITTY_BIN:-}" || -z "${FZF_DEFAULT_OPTS:-}" || -z "${active_color:-}" || -z "${reset_color:-}" ]] && source "${SCRIPT_DIR}/fzf-theme"

launch_window_id="${KITTY_WINDOW_ID:-}"

all_mode="${KT_ALL:-0}"
if [[ "${1:-}" == "--all" ]]; then
  all_mode=1
  shift
fi

build_lines() {
  local json="${1:-}"
  if [[ -z "${json}" ]]; then
    json="$("${KITTY_BIN}" @ ls 2>/dev/null || true)"
  fi
  [[ -z "${json}" ]] && return 0

  local tabs_data
  tabs_data="$(
    jq -r --arg w "${launch_window_id}" --arg all "${all_mode}" '
      (first(.[]?.tabs[]? | select(any(.windows[]?; (.id|tostring) == $w))) // null) as $launch_tab
      | (first($launch_tab.windows[]?.session_name | select(. != null and . != "")) // null) as $sess
      | .[]?.tabs[]?
      | (first(.windows[]?.session_name | select(. != null and . != "")) // null) as $tabsess
      | select( ($all == "1") or ($sess == null) or ($tabsess == $sess) )
      | (any(.windows[]?; (.id|tostring) == $w)) as $cur
      | [ .windows[] | select(($w == "") or ((.id|tostring) != $w)) ] as $wins
      | [ (.id|tostring),
          (if $cur then "1" else "0" end),
          (if $cur then
             (first($wins[] | select(.is_active == true) | .title) // $wins[0]?.title // .title)
           else .title end),
          (first($wins[] | select(.is_active == true) | (.env.PWD // .cwd)) // $wins[0]?.env.PWD // $wins[0]?.cwd // .windows[0].env.PWD // .windows[0].cwd // "") ]
      | @tsv
    ' <<< "${json}" || true
  )"

  [[ -z "${tabs_data}" ]] && return 0

  local tab_id is_current title cwd disp cur_line="" line
  local -a rest=() parts=()
  local -i idx=0
  for line in "${(f)tabs_data}"; do
    parts=( "${(@ps:\t:)line}" )
    tab_id="${parts[1]:-}"
    is_current="${parts[2]:-}"
    title="${parts[3]:-}"
    cwd="${parts[4]:-}"
    idx+=1
    disp="${idx}: ${title}  (${(D)cwd})"
    if [[ "${is_current}" == "1" ]]; then
      cur_line="${active_color}${disp}${reset_color}"$'\t'"${tab_id}"
    else
      rest+=("${disp}"$'\t'"${tab_id}")
    fi
  done

  [[ -n "${cur_line}" ]] && print -r -- "${cur_line}"
  (( ${#rest} )) && print -l -r -- "${rest[@]}"
}

if [[ "${1:-}" == "--close-and-list" ]]; then
  target="${2:-}"
  cur="${3:-}"
  json=""
  if [[ -n "${target}" && "${target}" != "${cur}" ]]; then
    json="$("${KITTY_BIN}" @ ls 2>/dev/null || true)"
    if ! jq --arg target "${target}" -e '
      any(.[]?.tabs[]? | select((.id|tostring) == $target).windows[]?; .pid as $wpid | any(.foreground_processes[]?; .pid != $wpid))
    ' <<< "${json}" >/dev/null 2>&1; then
      "${KITTY_BIN}" @ close-tab --match "id:${target}" 2>/dev/null || true
      json=""
    fi
  fi
  build_lines "${json}"
  exit 0
fi

main_json="$("${KITTY_BIN}" @ ls 2>/dev/null || true)"
nohup "${SCRIPT_DIR}/kitty-session-cleanup" >/dev/null 2>&1 <<< "${main_json}" &!

lines="$(build_lines "${main_json}")"
if [[ -z "${lines}" ]]; then
  echo "No tabs found."
  exit 0
fi

typeset -i header_lines=0
current=""
first_line="${lines%%$'\n'*}"
if [[ "${first_line}" == $'\033'* ]]; then
  header_lines=1
  current="${first_line##*$'\t'}"
fi

export KT_SELF="${0:a}" KT_CURRENT="${current}" KT_ALL="${all_mode}"

typeset prompt_label="Switch Tab > "
[[ "${all_mode}" == "1" ]] && prompt_label="Switch Tab (all) > "

set +e
selected="$(print -r -- "${lines}" | fzf --no-sort \
  --ansi --header-lines=${header_lines} \
  -d $'\t' --with-nth=1 --prompt="${prompt_label}" --no-multi \
  --header='ctrl-x: to close' \
  --bind='ctrl-x:reload("$KT_SELF" --close-and-list {2} "$KT_CURRENT")')"
fzf_rc=$?
set -e

if [[ $fzf_rc -ne 0 || -z "${selected}" ]]; then
  exit 0
fi

selected_tab="${selected#*$'\t'}"
"${KITTY_BIN}" @ focus-tab --match "id:${selected_tab}" 2>/dev/null || true
