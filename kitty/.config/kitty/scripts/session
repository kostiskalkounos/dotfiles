#!/usr/bin/env zsh

source "${0:a:h}/common"

build_active_lines() {
  local cur="${1:-}"
  local active_sess="${2:-}"
  local prev_sess="${3:-}"

  [[ -n "${active_sess}" ]] || return 0

  local -A visited
  local -a lines=()
  local cur_line="" line sname pwd_dir disp sname_part
  local -a parts=()
  for line in "${(f)active_sess}"; do
    parts=( "${(@ps:$tab:)line}" )
    sname="${parts[1]:-}"
    pwd_dir="${parts[2]:-}"
    [[ -z "$sname" ]] && continue
    [[ -n "${visited[$sname]:-}" ]] && continue
    visited[$sname]=1

    sname_part="${sname:t}"
    format_display_line "${sname_part}" "${(D)pwd_dir}"
    disp="${REPLY_DISP}"
    if [[ -n "${cur}" && "${sname}" == "${cur}" ]]; then
      cur_line="${ACTIVE_COLOR}${disp}${RESET_COLOR}${tab}${sname}"
    else
      lines+=("${disp}${tab}${sname}")
    fi
  done

  local -a sorted_lines=( "${(oi)lines[@]}" )
  reorder_lines_with_previous "${prev_sess}" "${sorted_lines[@]}"
  sorted_lines=( "${REPLY_LINES[@]}" )

  print_fzf_lines "${cur_line}" "${sorted_lines[@]}"
}

if [[ "${1:-}" == "--close-and-list" ]]; then
  typeset target="${2:-}"
  typeset cur="${3:-}"
  typeset json=""
  if [[ -n "${target}" && "${target}" != "${cur}" ]]; then
    json="$("${KITTY_BIN}" @ ls 2>/dev/null || true)"
    if ! has_active_processes "session" "${target}" "${json}"; then
      "${KITTY_BIN}" @ close-window --match "session:${target}" 2>/dev/null || true
      if [[ -f "${target}" ]]; then
        rm -f "${target}" 2>/dev/null || true
      elif [[ -f "${SESSION_DIR}/${target}" ]]; then
        rm -f "${SESSION_DIR}/${target}" 2>/dev/null || true
      fi
      json="$("${KITTY_BIN}" @ ls 2>/dev/null || true)"
      trigger_cleanup "${json}"
    fi
  fi

  typeset jq_out="$(get_sessions_data "${json}" "${launch_window_id:-0}")"
  parse_jq_session_lines "${jq_out}"
  build_active_lines "${REPLY_CUR_SESS}" "${REPLY_ACTIVE_SESSIONS_DATA}" "${REPLY_PREV_SESS}"
  exit 0
fi

typeset -U paths=()
typeset -a zipped=() active_sessions=()
typeset -i kitty_fd=0 zoxide_fd=0
typeset active_sessions_data=""
typeset raw_ls_data=""
typeset safe_base=""
typeset zoxide_out=""

typeset active_mode=false
typeset close_mode=false
if [[ "${1:-}" == "--active" ]]; then
  active_mode=true
elif [[ "${1:-}" == "--close" ]]; then
  close_mode=true
fi

if [[ "${active_mode}" == "true" || "${close_mode}" == "true" ]]; then
  raw_ls_data="$("${KITTY_BIN}" @ ls 2>/dev/null || true)"
else
  exec {kitty_fd}< <("${KITTY_BIN}" @ ls 2>/dev/null || true)
  exec {zoxide_fd}< <(zoxide query -l 2>/dev/null || true)

  raw_ls_data="$(< /dev/fd/$kitty_fd)"
  zoxide_out="$(< /dev/fd/$zoxide_fd)"

  exec {kitty_fd}<&-
  exec {zoxide_fd}<&-

  paths=( ${(f)zoxide_out} )
  paths=( $paths[1,250] )
fi

typeset jq_output="$(get_sessions_data "${raw_ls_data}" "${launch_window_id:-0}")"
parse_jq_session_lines "${jq_output}"
trigger_cleanup "${raw_ls_data}"
typeset cur_sess="${REPLY_CUR_SESS}"
active_sessions_data="${REPLY_ACTIVE_SESSIONS_DATA}"

if [[ -n "${active_sessions_data}" ]]; then
  active_sessions=( ${(u)${${(f)active_sessions_data}%%${tab}*}:t} )
fi

session_exists() {
  (( ${active_sessions[(I)${(b)1}]} ))
}

if [[ "${active_mode}" == "true" || "${close_mode}" == "true" ]]; then
  typeset lines="$(build_active_lines "${cur_sess}" "${active_sessions_data}" "${REPLY_PREV_SESS}")"
  if [[ -z "${lines}" ]]; then
    echo "No active sessions found."
    exit 0
  fi

  if [[ "${active_mode}" == "true" ]]; then
    run_kitty_fzf_with_close "${0:a}" "${lines}" "Switch Session > " "ctrl-x"

    if [[ $FZF_RC -ne 0 || -z "${FZF_SELECTED}" ]]; then
      exit 0
    fi

    typeset selected_session="${FZF_SELECTED##*${tab}}"
    "${KITTY_BIN}" @ action goto_session "${selected_session}"
    exit 0
  fi

  if [[ "${close_mode}" == "true" ]]; then
    run_kitty_fzf_with_close "${0:a}" "${lines}" "Close Session > " "enter"
    exit 0
  fi
fi

typeset cur_dir=""
if [[ -n "${cur_sess}" ]]; then
  if [[ -n "${active_sessions_data}" ]]; then
    typeset pattern="${(b)cur_sess}${tab}*"
    typeset -a matched=( ${(M)${(f)active_sessions_data}:#$~pattern} )
    if (( ${#matched} )); then
      cur_dir="${matched[1]#*${tab}}"
    fi
  fi
  if [[ -z "${cur_dir}" ]]; then
    typeset sf="${cur_sess}"
    if [[ ! -r "${sf}" ]]; then
      sf="${SESSION_DIR}/${cur_sess:t}"
    fi
    if [[ -r "${sf}" ]]; then
      typeset content="$(< "${sf}")"
      cur_dir="${content%%$'\n'*}"
      cur_dir="${cur_dir#cd }"
    fi
  fi
fi

typeset p="" disp="" cur_line=""
for p in "${paths[@]}"; do
  [[ -z "${p}" ]] && continue
  disp="${(D)p}"
  if [[ -n "${cur_dir}" && "${p}" == "${cur_dir}" ]]; then
    cur_line="${ACTIVE_COLOR}${disp}${RESET_COLOR}${tab}${p}"
  else
    zipped+=("${disp}${tab}${p}")
  fi
done

typeset -a picker=()
[[ -n "${cur_line}" ]] && picker+=("${cur_line}")
picker+=("${zipped[@]}")

if (( ${#picker} == 0 )); then
  echo "No directories found."
  exit 0
fi

typeset picker_lines="${(F)picker}"

run_kitty_fzf "${picker_lines}" "Select Session > " "" --no-sort

typeset selected="${FZF_SELECTED}"
typeset -i fzf_rc=$FZF_RC

if [[ $fzf_rc -ne 0 || -z "${selected}" ]]; then
  exit 0
fi

typeset selected_path="${selected##*${tab}}"

if [[ ! -d "${selected_path}" ]]; then
  echo "Directory not found: ${selected_path}"
  exit 1
fi

typeset real_target="${selected_path%/}"
[[ -z "${real_target}" ]] && real_target="/"

typeset base_name="${real_target:t}"

sanitize "${base_name}"; safe_base="${REPLY}"

typeset existing_session=""
if [[ -n "${active_sessions_data}" ]]; then
  typeset pattern="*${tab}${(b)real_target}"
  typeset -a matched=( ${(M)${(f)active_sessions_data}:#$~pattern} )

  if (( ${#matched} )); then
    existing_session="${matched[1]%%${tab}*}"
  else
    typeset real_target_abs="${real_target:A}"
    pattern="*${tab}${(b)real_target_abs}"
    matched=( ${(M)${(f)active_sessions_data}:#$~pattern} )

    if (( ${#matched} )); then
      existing_session="${matched[1]%%${tab}*}"
    else
      typeset line active_sname pwd_dir
      for line in "${(f)active_sessions_data}"; do
        active_sname="${line%%${tab}*}"
        pwd_dir="${line#*${tab}}"
        [[ -z "$active_sname" || -z "$pwd_dir" ]] && continue
        if [[ "${pwd_dir:A}" == "${real_target_abs}" ]]; then
          existing_session="${active_sname}"
          break
        fi
      done
    fi
  fi
fi

zoxide add "${real_target}" >/dev/null 2>&1 < /dev/null &!

if [[ -n "${existing_session}" ]]; then
  "${KITTY_BIN}" @ action goto_session "${existing_session}"
  exit 0
fi

typeset session_name="${safe_base:-root}"
if session_exists "${session_name}"; then
  typeset parent_name="${real_target:h:t}"
  parent_name="${parent_name#.}"
  if [[ -n "${parent_name}" ]]; then
    sanitize "${parent_name}"; typeset safe_parent="${REPLY}"
    session_name="${safe_parent}-${safe_base}"
  fi

  if session_exists "${session_name}"; then
    session_name="${safe_base}-$$"
  fi
fi

[[ -d "${SESSION_DIR}" ]] || mkdir -p "${SESSION_DIR}"
typeset session_file="${SESSION_DIR}/${session_name}"

cat >"${session_file}" <<EOF
cd ${real_target}
launch
EOF

"${KITTY_BIN}" @ action goto_session "${session_file}"
