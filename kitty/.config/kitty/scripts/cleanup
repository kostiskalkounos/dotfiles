#!/usr/bin/env zsh

set -euo pipefail
setopt nullglob extendedglob bareglobqual

SCRIPT_DIR="${0:a:h}"
source "${SCRIPT_DIR}/common"

[[ -t 0 ]] && exit 0

json="$(</dev/stdin)"
[[ -n "${json}" ]] || exit 0

[[ -d "${SESSION_DIR}" ]] || exit 0

cleanup_filter='
  .[]?.tabs[]?.windows[]?
  | select(.session_name != null and .session_name != "")
  | .session_name
'
jq_output="$(jq -r "${cleanup_filter}" 2>/dev/null <<< "${json}" || true)"

typeset -A active_session_names
local line
for line in ${(f)jq_output}; do
  [[ -z "${line}" ]] && continue
  active_session_names[${line:t}]=1
done

local f base
typeset -a to_delete=()
for f in "${SESSION_DIR}"/*(.ms+2); do
  base="${f:t}"
  [[ -n "${active_session_names[$base]:-}" ]] && continue
  to_delete+=("${f}")
done

if (( ${#to_delete} > 0 )); then
  rm -f "${to_delete[@]}"
fi
