#!/usr/bin/env -S zsh -f

source "${0:a:h}/common"

[[ -t 0 ]] && exit 0

typeset json="$(</dev/stdin)"
[[ -n "${json}" ]] || exit 0

[[ -d "${SESSION_DIR}" ]] || exit 0

typeset cleanup_filter='
  .[]?.tabs[]?.windows[]?
  | select(.session_name != null and .session_name != "")
  | .session_name
'
typeset jq_output="$(jq -r "${cleanup_filter}" 2>/dev/null <<< "${json}")" || exit 0

typeset -a keys=( ${(u)${${(f)jq_output}:#}:t} )
typeset -a vals=( ${keys[@]/*/1} )
typeset -A active_session_names=( ${keys:^vals} )

typeset -a to_delete=()
typeset f="" base="" pid=""
for f in "${SESSION_DIR}"/*(.ms+2,=ms+2oN); do
  base="${f:t}"
  if [[ -S "$f" && "$base" = kitty-[0-9]## ]]; then
    pid="${base#kitty-}"
    if kill -0 "$pid" 2>/dev/null; then
      continue
    fi
  fi
  [[ -n "${active_session_names[$base]:-}" ]] && continue
  to_delete+=("${f}")
done

if (( ${#to_delete} > 0 )); then
  rm -f "${to_delete[@]}"
fi
