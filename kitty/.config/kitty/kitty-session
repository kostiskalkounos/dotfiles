#!/usr/bin/env zsh

set -euo pipefail
setopt nullglob extendedglob

SCRIPT_DIR="${0:a:h}"

typeset -U path
path=(/opt/homebrew/bin /usr/local/bin /usr/bin /bin /usr/sbin /sbin $path)

[[ -z "${KITTY_BIN:-}" || -z "${FZF_DEFAULT_OPTS:-}" || -z "${active_color:-}" || -z "${reset_color:-}" ]] && source "${SCRIPT_DIR}/fzf-theme"

session_dir="$HOME/.cache/kitty-sessions"

raw_ls_data=""
active_sessions_data=""
typeset -g -A active_session_names=()
typeset -a paths zipped

active_mode=false
if [[ "${1:-}" == "--active" ]]; then
  active_mode=true
fi

if [[ "${active_mode}" == "true" ]]; then
  raw_ls_data="$("${KITTY_BIN}" @ ls 2>/dev/null || true)"
else
  exec {kitty_fd}< <("${KITTY_BIN}" @ ls 2>/dev/null)
  exec {zoxide_fd}< <(zoxide query -l 2>/dev/null)

  raw_ls_data="$(< /dev/fd/$kitty_fd)"
  zoxide_out="$(< /dev/fd/$zoxide_fd)"

  exec {kitty_fd}<&-
  exec {zoxide_fd}<&-

  paths=( ${(f)zoxide_out} )
  paths=( "${paths[@]:#}" )
  paths=( "${paths[@][1,250]}" )
fi

launch_window_id="${KITTY_WINDOW_ID:-}"

jq_output="$(
  jq -r --arg w "${launch_window_id}" '
    (first(.[]?.tabs[]? | select(any(.windows[]?; (.id|tostring) == $w))) // null) as $launch_tab
    | (first($launch_tab.windows[]?.session_name | select(. != null and . != "")) // null) as $curr_sess
    | ($launch_tab.id // "" | tostring) as $launch_tab_id
    | ([ $launch_tab?.windows[]? | select(.session_name != null and .session_name != "") ] | length | tostring) as $launch_tab_sess_wins
    | "SESSION:\($curr_sess // "")",
      "LAUNCH_TAB:\($launch_tab_id)\t\($launch_tab_sess_wins)",
      (.[]?.tabs[]?.windows[]? | select(.session_name != null and .session_name != "") | [(.session_name|tostring), (.env.PWD // .cwd // "")] | @tsv)
  ' 2>/dev/null <<< "${raw_ls_data}" || true
)"

typeset -a jq_lines=( ${(f)jq_output} )
cur_sess=""
launch_tab_info=""
active_sessions_data=""

local line
for line in "${jq_lines[@]}"; do
  if [[ "${line}" == SESSION:* ]]; then
    cur_sess="${line#SESSION:}"
  elif [[ "${line}" == LAUNCH_TAB:* ]]; then
    launch_tab_info="${line#LAUNCH_TAB:}"
  else
    active_sessions_data+="${line}"$'\n'
  fi
done

if [[ -n "${active_sessions_data}" ]]; then
  for line in "${(f)active_sessions_data}"; do
    local sname="${line%%$'\t'*}"
    [[ -z "$sname" ]] && continue
    active_session_names[${${sname:t}%.kitty-session}]=1
  done
fi

session_exists() {
  [[ -n "${active_session_names[$1]:-}" ]]
}



sanitize() {
  local s="${1//[^A-Za-z0-9._-]/_}"
  REPLY="${s//_##/_}"
}

close_launch_tab() {
  [[ -n "${launch_window_id}" ]] || return 0
  [[ -n "${launch_tab_info}" ]] || return 0
  local tab_id="${launch_tab_info%%$'\t'*}"
  local session_windows="${launch_tab_info#*$'\t'}"
  [[ "${session_windows}" == "0" ]] || return 0
  [[ -n "${tab_id}" ]] && "${KITTY_BIN}" @ close-tab --match "id:${tab_id}" >/dev/null 2>&1 || true
}

if [[ "${active_mode}" == "true" ]]; then
  "${SCRIPT_DIR}/kitty-session-cleanup" >/dev/null 2>&1 <<< "${raw_ls_data}" &!
  if [[ -z "${active_sessions_data}" ]]; then
    echo "No active sessions found."
    exit 0
  fi

  typeset -A visited
  typeset -a lines
  typeset cur_line=""
  for line in "${(f)active_sessions_data}"; do
    typeset sname="${line%%$'\t'*}"
    typeset pwd_dir="${line#*$'\t'}"
    [[ -z "$sname" ]] && continue
    [[ -n "${visited[$sname]:-}" ]] && continue
    visited[$sname]=1

    typeset disp="${${sname:t}%.kitty-session}  (${(D)pwd_dir})"
    if [[ -n "${cur_sess}" && "${sname}" == "${cur_sess}" ]]; then
      cur_line="${active_color}${disp}${reset_color}"$'\t'"${sname}"
    else
      lines+=("${disp}"$'\t'"${sname}")
    fi
  done

  typeset -i header_lines=0
  typeset -a picker=()
  [[ -n "${cur_line}" ]] && { picker+=("${cur_line}"); header_lines=1; }
  picker+=("${lines[@]}")

  set +e
  selected="$(print -l -r -- "${picker[@]}" | fzf --ansi --header-lines=${header_lines} -d $'\t' --with-nth=1 --prompt="Switch Session > " --no-multi)"
  fzf_rc=$?
  set -e

  if [[ $fzf_rc -ne 0 || -z "${selected}" ]]; then
    exit 0
  fi

  selected_session="${selected#*$'\t'}"
  "${KITTY_BIN}" @ action goto_session "${selected_session}"
  close_launch_tab
  exit 0
fi

"${SCRIPT_DIR}/kitty-session-cleanup" >/dev/null 2>&1 <<< "${raw_ls_data}" &!

typeset cur_dir=""
if [[ -n "${cur_sess}" ]]; then
  typeset sf="${session_dir}/${cur_sess}.kitty-session"
  if [[ -r "${sf}" ]]; then
    typeset content="$(< "${sf}")"
    cur_dir="${${content#cd }%%$'\n'*}"
  fi
fi

typeset p="" disp="" cur_line=""
typeset -A seen_paths=()
for p in "${paths[@]}"; do
  [[ -n "${seen_paths[$p]:-}" ]] && continue
  seen_paths[$p]=1
  disp="${(D)p}"
  if [[ -n "${cur_dir}" && "${p}" == "${cur_dir}" ]]; then
    cur_line="${active_color}${disp}${reset_color}"$'\t'"${p}"
  else
    zipped+=("${disp}"$'\t'"${p}")
  fi
done

typeset -i header_lines=0
typeset -a picker=()
[[ -n "${cur_line}" ]] && { picker+=("${cur_line}"); header_lines=1; }
picker+=("${zipped[@]}")

if (( ${#picker} == 0 )); then
  echo "No directories found."
  exit 0
fi

set +e
selected="$(print -l -r -- "${picker[@]}" | fzf --no-sort --ansi --header-lines=${header_lines} -d $'\t' --with-nth=1 --prompt="Select Session > " --no-multi)"
fzf_rc=$?
set -e

if [[ $fzf_rc -ne 0 || -z "${selected}" ]]; then
  exit 0
fi

selected_path="${selected#*$'\t'}"

if [[ ! -d "${selected_path}" ]]; then
  echo "Directory not found: ${selected_path}"
  exit 1
fi

real_target="${selected_path%/}"
[[ -z "${real_target}" ]] && real_target="/"

base_name="${real_target:t}"

sanitize "${base_name}"; safe_base="${REPLY}"

existing_session=""
typeset real_target_abs=""
if [[ -n "${active_sessions_data}" ]]; then
  typeset session_name pwd_dir
  for line in "${(f)active_sessions_data}"; do
    session_name="${line%%$'\t'*}"
    pwd_dir="${line#*$'\t'}"
    [[ -z "$session_name" || -z "$pwd_dir" ]] && continue

    if [[ "${pwd_dir}" == "${real_target}" ]]; then
      existing_session="$session_name"
      break
    else
      if [[ -z "${real_target_abs}" ]]; then
        real_target_abs="${real_target:A}"
      fi
      if [[ "${pwd_dir}" == "${real_target_abs}" ]]; then
        existing_session="$session_name"
        break
      elif [[ "${pwd_dir:A}" == "${real_target_abs}" ]]; then
        existing_session="$session_name"
        break
      fi
    fi
  done
fi

if [[ -n "${existing_session}" ]]; then
  zoxide add "${real_target}" >/dev/null 2>&1 < /dev/null &!
  "${KITTY_BIN}" @ action goto_session "${existing_session}"
  close_launch_tab
  exit 0
fi

session_name="${safe_base}"
if session_exists "${session_name}"; then
  parent_name="${real_target:h:t}"
  parent_name="${parent_name#.}"
  if [[ -n "${parent_name}" ]]; then
    sanitize "${parent_name}"; safe_parent="${REPLY}"
    session_name="${safe_parent}-${safe_base}"
  fi

  if session_exists "${session_name}"; then
    session_name="${safe_base}-$$"
  fi
fi

[[ -d "${session_dir}" ]] || mkdir -p "${session_dir}"
session_file="${session_dir}/${session_name}.kitty-session"

cat >"${session_file}" <<EOF
cd ${real_target}
launch
EOF

zoxide add "${real_target}" >/dev/null 2>&1 < /dev/null &!
"${KITTY_BIN}" @ action goto_session "${session_file}"
close_launch_tab
